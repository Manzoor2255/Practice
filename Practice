import seaborn as sns
from sklearn.datasets import load_iris

# Load fresh copy of data
iris = load_iris()
X_data = iris.data[:, 0]  # Sepal Length
y_data = iris.data[:, 2]  # Petal Length

sns.set_theme(style="whitegrid")

# Plot distribution of Sepal Length
plt.figure(figsize=(8, 4))
sns.histplot(X_data, kde=True, color="skyblue", bins=15)
plt.title("Distribution of Sepal Length (Feature X)")
plt.xlabel("Sepal Length (cm)")
plt.ylabel("Frequency")
plt.show()

# Plot distribution of Petal Length
plt.figure(figsize=(8, 4))
sns.histplot(y_data, kde=True, color="salmon", bins=15)
plt.title("Distribution of Petal Length (Target y)")
plt.xlabel("Petal Length (cm)")
plt.ylabel("Frequency")
plt.show()
-------------------------------------------------------------------------------------
import numpy as np
from sklearn.linear_model import LinearRegression

# Fit the regression model
model_lr = LinearRegression()
model_lr.fit(X_data.reshape(-1, 1), y_data)

# Define the equations
m_best = model_lr.coef_[0]
b_best = model_lr.intercept_

# Alternative lines (suboptimal)
m1, b1 = 1.2, -3.0
m2, b2 = 2.5, -11.0

# Generate predictions over the x-range
x_sorted = np.sort(X_data)
y_best_pred = m_best * x_sorted + b_best
y_alt1_pred = m1 * x_sorted + b1
y_alt2_pred = m2 * x_sorted + b2

# Visualization
plt.figure(figsize=(10, 6))
plt.scatter(X_data, y_data, color='gray', alpha=0.6, label="Actual Data")
plt.plot(x_sorted, y_best_pred, color='green', linewidth=2.5, label=f"Best Fit (m={m_best:.2f}, b={b_best:.2f})")
plt.plot(x_sorted, y_alt1_pred, color='orange', linestyle='--', linewidth=2, label=f"Alt Line 1 (m={m1:.2f}, b={b1:.2f})")
plt.plot(x_sorted, y_alt2_pred, color='red', linestyle='--', linewidth=2, label=f"Alt Line 2 (m={m2:.2f}, b={b2:.2f})")

plt.xlabel("Sepal Length (cm)")
plt.ylabel("Petal Length (cm)")
plt.title("Multi-Line Fit Comparison")
plt.legend()
plt.grid(True)
plt.show()


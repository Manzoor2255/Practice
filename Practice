from sklearn.metrics import mean_squared_error, r2_score

# Calculate predictions on original X
y_best_all = model_lr.predict(X_data.reshape(-1, 1))
y_alt1_all = m1 * X_data + b1
y_alt2_all = m2 * X_data + b2

print("--- PERFORMANCE EVALUATION ---")
print(f"Best Fit Line:  MSE = {mean_squared_error(y_data, y_best_all):.4f} | R² = {r2_score(y_data, y_best_all):.4f}")
print(f"Alt Line 1:     MSE = {mean_squared_error(y_data, y_alt1_all):.4f} | R² = {r2_score(y_data, y_alt1_all):.4f}")
print(f"Alt Line 2:     MSE = {mean_squared_error(y_data, y_alt2_all):.4f} | R² = {r2_score(y_data, y_alt2_all):.4f}")
